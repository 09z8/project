local function makeButton(yOffset, height, label, accent1, accent2)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.fromOffset(BW, height)
    Btn.Position = UDim2.new(0.5, -BW / 2, 0, yOffset)
    Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
    Btn.BorderSizePixel = 0
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.ZIndex = 3
    Btn.Parent = Frame

    local BtnCorner = Instance.new("UICorner", Btn)
    BtnCorner.CornerRadius = UDim.new(0, 10)

    local BtnStroke = Instance.new("UIStroke", Btn)
    BtnStroke.Color = accent1
    BtnStroke.Thickness = 1
    BtnStroke.Transparency = 0.5

    local BtnGrad = Instance.new("UIGradient", Btn)
    BtnGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(48, 44, 72)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 28, 48)),
    })
    BtnGrad.Rotation = 90

    local BtnLabel = Instance.new("TextLabel")
    BtnLabel.Size = UDim2.new(1, 0, 0, BH)
    BtnLabel.BackgroundTransparency = 1
    BtnLabel.Text = label
    BtnLabel.TextColor3 = Color3.fromRGB(220, 220, 255)
    BtnLabel.TextSize = 15
    BtnLabel.Font = Enum.Font.GothamMedium
    BtnLabel.ZIndex = 4
    BtnLabel.Parent = Btn

    Btn.MouseEnter:Connect(function()
        BtnStroke.Transparency = 0
        BtnGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 58, 110)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 40, 85)),
        })
        BtnLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    Btn.MouseLeave:Connect(function()
        BtnStroke.Transparency = 0.5
        BtnGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(48, 44, 72)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 28, 48)),
        })
        BtnLabel.TextColor3 = Color3.fromRGB(220, 220, 255)
    end)
    Btn.MouseButton1Down:Connect(function()
        BtnGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accent1),
            ColorSequenceKeypoint.new(1, accent2),
        })
    end)
    Btn.MouseButton1Up:Connect(function()
        BtnGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 58, 110)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 40, 85)),
        })
    end)

    return Btn
end

